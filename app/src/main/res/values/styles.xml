<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#E8C387</item>
        <item name="android:windowBackground">#102727</item>
        <item name="android:statusBarColor">#102727</item>
        <item name="android:navigationBarColor">#102727</item>
    </style>
    <!-- Full-screen transparent window for CarSheet: the card draws itself, the screen behind dims 62 %. -->
    <style name="CarSheet" parent="AppTheme">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.62</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
</resources>
