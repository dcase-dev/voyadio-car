<?xml version="1.0" encoding="utf-8"?>
<!-- Pleos debug build only (2026-10-21): checks the car's speech recognizer with recorded audio (pleos/SttProbe), and
     the navigation and gear (pleos/CarProbe) — setting a destination needs NAVI_ROUTE_SEARCH, the app itself only reads. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <application>
        <receiver android:name=".pleos.SttProbe" android:exported="true">
            <intent-filter>
                <action android:name="com.voyadio.automotive.debug.STT_PROBE" />
            </intent-filter>
        </receiver>
        <receiver android:name=".pleos.CarProbe" android:exported="true">
            <intent-filter>
                <action android:name="com.voyadio.automotive.debug.CAR_PROBE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
